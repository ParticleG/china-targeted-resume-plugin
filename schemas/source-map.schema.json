{
  "$defs": {
    "ClaimMode": {
      "enum": [
        "extractive",
        "reviewed-semantic"
      ],
      "title": "ClaimMode",
      "type": "string"
    },
    "DisclosurePolicy": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "title": "DisclosurePolicy",
      "type": "string"
    },
    "FactPolicy": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6"
      ],
      "title": "FactPolicy",
      "type": "string"
    },
    "ProposalDomain": {
      "enum": [
        "role",
        "company",
        "roadmap",
        "evidence",
        "job-description",
        "personal"
      ],
      "title": "ProposalDomain",
      "type": "string"
    },
    "ProposalOwner": {
      "enum": [
        "candidate",
        "team",
        "organization",
        "role",
        "company",
        "unknown"
      ],
      "title": "ProposalOwner",
      "type": "string"
    },
    "SemanticProposal": {
      "additionalProperties": false,
      "description": "An agent proposal bound to one exact source slice.",
      "properties": {
        "claim_mode": {
          "$ref": "#/$defs/ClaimMode",
          "default": "extractive"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "contribution_qualifiers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Contribution Qualifiers",
          "type": "array"
        },
        "domain": {
          "$ref": "#/$defs/ProposalDomain"
        },
        "metric_qualifiers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Metric Qualifiers",
          "type": "array"
        },
        "owner": {
          "$ref": "#/$defs/ProposalOwner"
        },
        "proposal_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "proposed_claim": {
          "minLength": 1,
          "title": "Proposed Claim",
          "type": "string"
        },
        "reasoning": {
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "unresolved_questions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved Questions",
          "type": "array"
        }
      },
      "required": [
        "proposal_id",
        "source",
        "domain",
        "owner",
        "proposed_claim",
        "confidence",
        "reasoning"
      ],
      "title": "SemanticProposal",
      "type": "object"
    },
    "SourceBlockIR": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "document_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "heading_ancestry": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Heading Ancestry",
          "type": "array"
        },
        "section_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "structural_flags": {
          "$ref": "#/$defs/StructuralFlags"
        }
      },
      "required": [
        "block_id",
        "document_id",
        "span"
      ],
      "title": "SourceBlockIR",
      "type": "object"
    },
    "SourceDocumentIR": {
      "additionalProperties": false,
      "properties": {
        "document_disclosure_policy": {
          "$ref": "#/$defs/DisclosurePolicy",
          "default": "P3"
        },
        "document_fact_policy": {
          "$ref": "#/$defs/FactPolicy",
          "default": "F5"
        },
        "document_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)(?!.*[/]$)[^\\u0000]+$",
          "title": "Path",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validation_warnings": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Validation Warnings",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "path",
        "source_hash"
      ],
      "title": "SourceDocumentIR",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "A source identity plus one exact quote; never a source body.",
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "heading_ancestry": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Heading Ancestry",
          "type": "array"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)(?!.*[/]$)[^\\u0000]+$",
          "title": "Path",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        },
        "source_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "structural_flags": {
          "$ref": "#/$defs/StructuralFlags"
        }
      },
      "required": [
        "path",
        "source_hash",
        "span",
        "exact_quote"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourceSectionIR": {
      "additionalProperties": false,
      "properties": {
        "block_ids": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "document_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "duplicate_index": {
          "default": 0,
          "minimum": 0,
          "title": "Duplicate Index",
          "type": "integer"
        },
        "heading": {
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "heading_ancestry": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Heading Ancestry",
          "type": "array"
        },
        "section_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "structural_flags": {
          "$ref": "#/$defs/StructuralFlags"
        }
      },
      "required": [
        "section_id",
        "document_id",
        "span",
        "heading"
      ],
      "title": "SourceSectionIR",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "An inclusive line range and a half-open UTF-8 byte range.",
      "properties": {
        "end_byte": {
          "minimum": 1,
          "title": "End Byte",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "start_byte": {
          "minimum": 0,
          "title": "Start Byte",
          "type": "integer"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line",
        "start_byte",
        "end_byte"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "StructuralFlags": {
      "additionalProperties": false,
      "description": "Deterministic context captured for a source slice.",
      "properties": {
        "block_kind": {
          "default": "unknown",
          "minLength": 1,
          "title": "Block Kind",
          "type": "string"
        },
        "effective_disclosure_policy": {
          "$ref": "#/$defs/DisclosurePolicy",
          "default": "P3"
        },
        "effective_fact_policy": {
          "$ref": "#/$defs/FactPolicy",
          "default": "F5"
        },
        "inside_blockquote": {
          "default": false,
          "title": "Inside Blockquote",
          "type": "boolean"
        },
        "inside_fence": {
          "default": false,
          "title": "Inside Fence",
          "type": "boolean"
        },
        "inside_html": {
          "default": false,
          "title": "Inside Html",
          "type": "boolean"
        },
        "is_example": {
          "default": false,
          "title": "Is Example",
          "type": "boolean"
        },
        "is_quoted": {
          "default": false,
          "title": "Is Quoted",
          "type": "boolean"
        },
        "is_template": {
          "default": false,
          "title": "Is Template",
          "type": "boolean"
        },
        "malformed": {
          "default": false,
          "title": "Malformed",
          "type": "boolean"
        },
        "negative_instruction": {
          "default": false,
          "title": "Negative Instruction",
          "type": "boolean"
        },
        "secret_content": {
          "default": false,
          "title": "Secret Content",
          "type": "boolean"
        },
        "secret_path": {
          "default": false,
          "title": "Secret Path",
          "type": "boolean"
        }
      },
      "title": "StructuralFlags",
      "type": "object"
    }
  },
  "$id": "https://schemas.local/china-targeted-resume/source-map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Persistent structural metadata and per-proposal exact quotes only.",
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/SourceBlockIR"
      },
      "title": "Blocks",
      "type": "array"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/SourceDocumentIR"
      },
      "title": "Documents",
      "type": "array"
    },
    "proposals": {
      "items": {
        "$ref": "#/$defs/SemanticProposal"
      },
      "title": "Proposals",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/SourceSectionIR"
      },
      "title": "Sections",
      "type": "array"
    }
  },
  "title": "source-map",
  "type": "object"
}
