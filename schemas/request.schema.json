{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/china-targeted-resume/request.schema.json",
  "title": "RunRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_root", "output_root"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "default": 1},
    "source_root": {"type": "string", "minLength": 1},
    "source_adapter": {"type": "string", "default": "markdown-career-v1"},
    "company_ref": {"type": ["string", "object", "null"]},
    "role_ref": {"type": ["string", "object", "null"]},
    "jd": {"$ref": "#/$defs/jd"},
    "application_constraints": {"oneOf": [{"type": "object"}, {"type": "array", "items": {"type": "object"}}], "default": {}},
    "output_mode": {"enum": ["targeted_application", "public_portfolio", "master_resume"], "default": "targeted_application"},
    "language": {"type": "string", "default": "zh-CN"},
    "target_pages": {"type": "integer", "minimum": 1, "maximum": 6, "default": 2},
    "template": {"enum": ["ats-simple", "human-readable"], "default": "ats-simple"},
    "persist_role_research": {"type": "boolean", "default": false},
    "export_roadmap_handoff": {"type": "boolean", "default": false},
    "refresh_external_sources": {"type": "boolean", "default": false},
    "output_root": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "jd": {
      "type": "object", "additionalProperties": false,
      "properties": {"text": {"type": ["string", "null"]}, "url": {"type": ["string", "null"], "format": "uri"}, "file": {"type": ["string", "null"]}},
      "default": {}
    }
  }
}
