{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/china-targeted-resume/evidence-map.schema.json",
  "title": "EvidenceMap",
  "type": "object",
  "additionalProperties": false,
  "required": ["records", "mappings"],
  "properties": {
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "mappings": {"type": "array", "items": {"$ref": "#/$defs/mapping"}}
  },
  "$defs": {
    "state": {"enum": ["已有直接证据", "可迁移经验", "有知识无实践", "明确缺口", "待确认"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"], "format": "uri"},
        "title": {"type": ["string", "null"]},
        "section": {"type": ["string", "null"]},
        "source_hash": {"type": ["string", "null"]},
        "source_type": {"type": ["string", "null"]},
        "publisher": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"], "format": "date"},
        "accessed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "anyOf": [
        {"required": ["path"], "properties": {"path": {"type": "string"}}},
        {"required": ["url"], "properties": {"url": {"type": "string"}}}
      ]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dynamic": {"type": "boolean"},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "source_date": {"type": ["string", "null"], "format": "date"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "stale": {"type": "boolean"}
      }
    },
    "durationDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_scope",
        "required_scope",
        "unit",
        "candidate_years",
        "required_min_years",
        "evidence_refs",
        "checked_at"
      ],
      "properties": {
        "candidate_scope": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "(?:[/\\\\,，、;；]|\\b(?:and|or)\\b|[与及和])"}
        },
        "required_scope": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "(?:[/\\\\,，、;；]|\\b(?:and|or)\\b|[与及和])"}
        },
        "unit": {"const": "years"},
        "candidate_years": {"type": "number", "minimum": 0},
        "required_min_years": {"type": "number", "exclusiveMinimum": 0},
        "required_max_years": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "checked_at": {"type": "string", "format": "date-time"}
      }
    },
    "candidateDurationFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "unit", "years", "checked_at"],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "(?:[/\\\\,，、;；]|\\b(?:and|or)\\b|[与及和])"}
        },
        "unit": {"const": "years"},
        "years": {"type": "number", "exclusiveMinimum": 0},
        "checked_at": {"type": "string", "format": "date-time"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source", "fact_state", "disclosure", "match_state", "contribution_scope", "safe_claim"],
      "properties": {
        "evidence_id": {"type": "string"},
        "requirement_ids": {"type": "array", "items": {"type": "string"}},
        "source": {"$ref": "#/$defs/source"},
        "source_span": {"type": ["object", "null"]},
        "fact_state": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6"]},
        "disclosure": {"enum": ["P0", "P1", "P2", "P3"]},
        "match_state": {"$ref": "#/$defs/state"},
        "contribution_scope": {"type": "string"},
        "metric_precision": {"type": ["string", "null"]},
        "safe_claim": {"type": "string", "minLength": 1},
        "forbidden_expansions": {"type": "array", "items": {"type": "string"}},
        "freshness": {"$ref": "#/$defs/freshness"},
        "experience_duration_fact": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/candidateDurationFact"}
          ]
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "match_state", "selection_reason"],
      "properties": {
        "requirement_id": {"type": "string"},
        "match_state": {"$ref": "#/$defs/state"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "selection_reason": {"type": "string"},
        "resume_priority": {"type": "number", "minimum": 0, "maximum": 1},
        "interview_risks": {"type": "array", "items": {"type": "string"}},
        "missing_evidence": {"type": "array", "items": {"type": "string"}},
        "experience_duration_diagnostic": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/durationDiagnostic"}
          ]
        }
      },
      "if": {
        "properties": {"match_state": {"const": "已有直接证据"}},
        "required": ["match_state"]
      },
      "then": {
        "required": ["evidence_ids"],
        "properties": {
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
