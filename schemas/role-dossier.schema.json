{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/china-targeted-resume/role-dossier.schema.json",
  "title": "RoleDossierIR",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_context"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "target_context": {"$ref": "target-context.schema.json"},
    "requirements": {"$ref": "requirements.schema.json"},
    "competencies": {"$ref": "competencies.schema.json"},
    "application_constraints": {"$ref": "application-constraints.schema.json"},
    "evidence_candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "evidence_records": {"type": "array", "items": {"$ref": "evidence-map.schema.json#/$defs/record"}},
    "evidence_mappings": {"type": "array", "items": {"$ref": "evidence-map.schema.json#/$defs/mapping"}},
    "gaps": {"$ref": "gaps.schema.json"},
    "application_recommendation": {"oneOf": [{"$ref": "application-recommendation.schema.json"}, {"type": "null"}]},
    "roadmap_handoff": {"$ref": "roadmap-handoff.schema.json"},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
    "anomalies": {"type": "array", "items": {"type": "string"}},
    "interview_questions": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "source_manifest": {"oneOf": [{"$ref": "#/$defs/manifest"}, {"type": "null"}]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "state": {"enum": ["已有直接证据", "可迁移经验", "有知识无实践", "明确缺口", "待确认"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": ["string", "null"]}, "url": {"type": ["string", "null"], "format": "uri"},
        "title": {"type": ["string", "null"]}, "section": {"type": ["string", "null"]},
        "source_hash": {"type": ["string", "null"]}, "source_type": {"type": ["string", "null"]},
        "publisher": {"type": ["string", "null"]}, "published_at": {"type": ["string", "null"], "format": "date"},
        "accessed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "anyOf": [{"required": ["path"], "properties": {"path": {"type": "string"}}}, {"required": ["url"], "properties": {"url": {"type": "string"}}}]
    },
    "span": {
      "type": "object", "additionalProperties": false, "required": ["start_line", "end_line"],
      "properties": {"start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "start_column": {"type": ["integer", "null"], "minimum": 1}, "end_column": {"type": ["integer", "null"], "minimum": 1}}
    },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "source_path", "source_hash", "title", "section", "section_anchor", "domain"],
      "properties": {"document_id": {"type": "string"}, "source_path": {"type": "string"}, "source_hash": {"type": "string"}, "title": {"type": "string"}, "section": {"type": "string"}, "section_anchor": {"type": "string"}, "domain": {"type": "string"}, "outgoing_internal_links": {"type": "array", "items": {"type": "string"}}, "start_line": {"type": ["integer", "null"], "minimum": 1}, "end_line": {"type": ["integer", "null"], "minimum": 1}}
    },
    "manifest": {
      "type": "object", "additionalProperties": false, "required": ["adapter", "root", "generated_at"],
      "properties": {"schema_version": {"type": "integer", "minimum": 1}, "adapter": {"type": "string"}, "root": {"type": "string"}, "generated_at": {"type": "string", "format": "date-time"}, "documents": {"type": "array", "items": {"type": "string"}}, "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}}
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "source", "proposed_claim", "fact_state", "disclosure", "match_state"],
      "properties": {"candidate_id": {"type": "string"}, "requirement_ids": {"type": "array", "items": {"type": "string"}}, "source": {"$ref": "#/$defs/source"}, "source_span": {"oneOf": [{"$ref": "#/$defs/span"}, {"type": "null"}]}, "proposed_claim": {"type": "string"}, "fact_state": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6"]}, "disclosure": {"enum": ["P0", "P1", "P2", "P3"]}, "match_state": {"$ref": "#/$defs/state"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "rejection_reasons": {"type": "array", "items": {"type": "string"}}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "evidence_ids", "source_refs", "fact_state", "disclosure", "output_mode", "rendered_claim"],
      "properties": {"claim_id": {"type": "string"}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "fact_state": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6"]}, "disclosure": {"enum": ["P0", "P1", "P2", "P3"]}, "output_mode": {"enum": ["targeted_application", "public_portfolio", "master_resume"]}, "rendered_claim": {"type": "string"}, "transformations": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
