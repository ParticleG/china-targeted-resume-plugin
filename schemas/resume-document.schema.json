{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/china-targeted-resume/resume-document.schema.json",
  "title": "ResumeDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "contact", "headline"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "variant": {"enum": ["recruiter-one-page", "technical-two-page", "extended-three-page"], "default": "technical-two-page"},
    "locale": {"type": "string"},
    "target": {"$ref": "#/$defs/target"},
    "contact": {"$ref": "#/$defs/contact"},
    "headline": {"type": "string"},
    "summary": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}},
    "experience": {"type": "array", "items": {"$ref": "#/$defs/experience"}},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}},
    "education": {"type": "array", "items": {"$ref": "#/$defs/education"}},
    "honors": {"type": "array", "items": {"$ref": "#/$defs/honor"}},
    "render_policy": {"$ref": "#/$defs/policy"},
    "provenance_refs": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "target": {"type": "object", "additionalProperties": false, "required": ["target_basis"], "properties": {"company": {"type": ["string", "null"]}, "role": {"type": ["string", "null"]}, "target_basis": {"enum": ["exact-current-jd", "exact-role-partial-evidence", "company-role-family", "insufficient-target"]}}},
    "link": {"type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": {"label": {"type": "string"}, "url": {"type": "string", "format": "uri"}}},
    "contact": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}, "phone": {"type": ["string", "null"]}, "email": {"type": ["string", "null"]}, "location": {"type": ["string", "null"]}, "links": {"type": "array", "items": {"$ref": "#/$defs/link"}}}},
    "bullet": {"type": "object", "additionalProperties": false, "required": ["text", "claim_ids"], "properties": {"text": {"type": "string"}, "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "priority": {"type": "number", "minimum": 0, "maximum": 1}}},
    "skill": {"type": "object", "additionalProperties": false, "required": ["group"], "properties": {"group": {"type": "string"}, "items": {"type": "array", "items": {"type": "string"}}}},
    "experience": {"type": "object", "additionalProperties": false, "required": ["organization", "role", "start_date", "end_date"], "properties": {"organization": {"type": "string"}, "role": {"type": "string"}, "location": {"type": ["string", "null"]}, "start_date": {"type": "string"}, "end_date": {"type": "string"}, "context": {"type": ["string", "null"]}, "bullets": {"type": "array", "items": {"$ref": "#/$defs/bullet"}}}},
    "project": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}, "role": {"type": ["string", "null"]}, "context": {"type": ["string", "null"]}, "start_date": {"type": ["string", "null"]}, "end_date": {"type": ["string", "null"]}, "technologies": {"type": "array", "items": {"type": "string"}}, "bullets": {"type": "array", "items": {"$ref": "#/$defs/bullet"}}}},
    "education": {"type": "object", "additionalProperties": false, "required": ["institution"], "properties": {"institution": {"type": "string"}, "degree": {"type": ["string", "null"]}, "field": {"type": ["string", "null"]}, "start_date": {"type": ["string", "null"]}, "end_date": {"type": ["string", "null"]}, "details": {"type": "array", "items": {"type": "string"}}}},
    "honor": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}, "issuer": {"type": ["string", "null"]}, "date": {"type": ["string", "null"]}, "details": {"type": ["string", "null"]}}},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_pages": {"type": "integer", "minimum": 1, "maximum": 6, "default": 1},
        "target_pages": {"type": "integer", "minimum": 1, "maximum": 6, "default": 2},
        "template": {"enum": ["ats-simple", "human-readable"]},
        "minimum_body_font_pt": {"type": "number", "minimum": 10, "maximum": 16},
        "minimum_margin_mm": {"type": "number", "minimum": 12, "maximum": 30}
      },
      "allOf": [
        {"if": {"properties": {"minimum_pages": {"const": 2}}, "required": ["minimum_pages"]}, "then": {"properties": {"target_pages": {"minimum": 2}}}},
        {"if": {"properties": {"minimum_pages": {"const": 3}}, "required": ["minimum_pages"]}, "then": {"properties": {"target_pages": {"minimum": 3}}}},
        {"if": {"properties": {"minimum_pages": {"const": 4}}, "required": ["minimum_pages"]}, "then": {"properties": {"target_pages": {"minimum": 4}}}},
        {"if": {"properties": {"minimum_pages": {"const": 5}}, "required": ["minimum_pages"]}, "then": {"properties": {"target_pages": {"minimum": 5}}}},
        {"if": {"properties": {"minimum_pages": {"const": 6}}, "required": ["minimum_pages"]}, "then": {"properties": {"target_pages": {"minimum": 6}}}}
      ]
    }
  }
}
